# Demo defaults — copy to .env.local and fill in for real deployment
NEXT_PUBLIC_SITE_NAME=[NGO NAME]
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true

# Supabase (leave empty to run in development demo mode with local JSON store)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin bootstrap (used only when staff.json is empty)
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=ChangeMe123!
SESSION_SECRET=please-set-a-long-random-string-min-32-chars

# Email notifications (Resend preferred; SMTP fallback; empty = nothing is sent)
# Sign up at https://resend.com, verify your sender domain, create an API key.
RESEND_API_KEY=
# Verified sender, e.g. "Shikshaa Sewa <hello@shikshasewa.org>"
EMAIL_FROM=
# Staff inbox for new-submission notifications (or set in Admin > Settings)
ADMIN_NOTIFICATION_EMAIL=
# Public base URL used for admin links inside emails
APP_URL=http://localhost:3000
# SMTP fallback (only used when RESEND_API_KEY is empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NGO <hello@example.org>"

# Optional: Bearer token for GET/POST /api/cron/outbox (scheduled retries)
CRON_SECRET=

# Payments — set from client-verified details in admin settings UI (never commit real QR)
NEXT_PUBLIC_UPI_ID=
