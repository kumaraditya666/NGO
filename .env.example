# Demo defaults — copy to .env.local and fill in for real deployment
NEXT_PUBLIC_SITE_NAME=[NGO NAME]
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true

# Supabase (leave empty to run in development demo mode with local JSON store)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin bootstrap (used only when staff.json is empty)
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=ChangeMe123!
SESSION_SECRET=please-set-a-long-random-string-min-32-chars

# Email (optional transactional provider via SMTP; empty = demo log mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NGO <hello@example.org>"

# Payments — set from client-verified details in admin settings UI (never commit real QR)
NEXT_PUBLIC_UPI_ID=
